# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# PostgreSQL (если DB_NAME не задан — используется SQLite)
# Контейнер db: 5433 на хосте → 5432 внутри (см. docker-compose.yml)
# 5433 — чтобы не конфликтовать с локальным PostgreSQL на :5432
DB_NAME=ob2_paid_content
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5433

# Сервис web в Docker Compose подключается к db по имени хоста db
# (DB_HOST=db задан в docker-compose.yml, .env для web не меняет это)

# HTTPS (только за reverse-proxy с TLS; на ВМ с HTTP :80 — false)
USE_HTTPS=false

# CORS (итерация 2: django-cors-headers)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# JWT (опционально, иначе defaults Simple JWT)
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=1

# Stripe (test keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_CURRENCY=rub
STRIPE_SUCCESS_URL=http://localhost/payment/success
STRIPE_CANCEL_URL=http://localhost/payment/cancel
STRIPE_SUBSCRIPTION_AMOUNT=990

# Webhook (stripe listen --forward-to localhost/api/payments/webhook/)
# STRIPE_WEBHOOK_SECRET=whsec_...
