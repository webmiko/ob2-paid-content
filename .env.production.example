# Production .env на ВМ (скопировать в .env, заполнить секреты). CI этот файл не перезаписывает.
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=your-vm-ip-or-domain,testserver
# true при HTTPS за reverse proxy; включает HSTS и secure cookies в Django
USE_HTTPS=true
SITE_URL=https://your-vm-ip-or-domain

DB_NAME=ob2_paid_content
DB_USER=ob2_app
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60

CORS_ALLOWED_ORIGINS=https://your-vm-ip-or-domain

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CURRENCY=rub
STRIPE_SUCCESS_URL=https://your-vm-ip-or-domain/payment/success
STRIPE_CANCEL_URL=https://your-vm-ip-or-domain/payment/cancel
STRIPE_SUBSCRIPTION_AMOUNT=990

# STRIPE_WEBHOOK_SECRET=whsec_...

# Имитация SMS (без провайдера): код в API/UI на /register
SMS_SHOW_CODE_IN_RESPONSE=true
SMS_VERIFICATION_REQUIRED=true
SMS_CODE_TTL_SECONDS=600

# Docker Hub deploy (на сервере или в CI)
# DOCKER_IMAGE=username/ob2-paid-content:sha
