# Production .env на ВМ (скопировать в .env, заполнить секреты). CI этот файл не перезаписывает.
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=your-vm-ip-or-domain,testserver
USE_HTTPS=false

DB_NAME=ob2_paid_content
DB_USER=ob2_app
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60

CORS_ALLOWED_ORIGINS=http://your-vm-ip-or-domain

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CURRENCY=rub
STRIPE_SUCCESS_URL=http://your-vm-ip-or-domain/payments/success/
STRIPE_CANCEL_URL=http://your-vm-ip-or-domain/payments/cancel/
STRIPE_SUBSCRIPTION_AMOUNT=990

# Docker Hub deploy (на сервере или в CI)
# DOCKER_IMAGE=username/ob2-paid-content:sha
